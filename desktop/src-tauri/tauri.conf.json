{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuE2 Studio Telesoho",
  "version": "3.7.1",
  "identifier": "com.telesoho.yue2-studio",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "devUrl": "http://127.0.0.1:3791",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "create": false,
        "title": "YuE2 Studio Telesoho",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "publisher": "Telesoho",
    "linux": { "appimage": { "bundleMediaFramework": true } },
    "active": true,
    "targets": [
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyOTNEMzQ1NDIzMjQ4N0QKUldSOVNESkNSZE9UQW5KcGpIRXNFNEIrYVE0UHJ2TVlqbDNmVm1wYUR5b3JRbzMvWlZqMVhXM1gK",
      "endpoints": [
        "https://github.com/telesoho/YuE2-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "YuE2-Studio"
}
